const cron = require('node-cron');
const Farm = require('../models/Farm');

class SubscriptionCron {
  constructor() {
    // تشغيل الـ Cron Job يومياً في تمام الساعة 00:01 صباحاً بتوقيت السيرفر
    // التعبير الزمني '1 0 * * *' يعني: الدقيقة 1، الساعة 0 (منتصف الليل)، كل يوم
    this.schedule = '1 0 * * *';
  }

  start() {
    cron.schedule(this.schedule, async () => {
      console.log('⏳ [CRON] Starting daily subscription check...');
      try {
        const now = new Date();

        // 1. تحديث المزارع التي انتهت فترتها التجريبية
        const trialResult = await Farm.updateMany(
          { 
            subscription_status: 'TRIAL', 
            trial_ends_at: { $lt: now } 
          },
          { 
            $set: { subscription_status: 'OVERDUE' } 
          }
        );

        // 2. تحديث المزارع التي انتهى اشتراكها المدفوع
        const activeResult = await Farm.updateMany(
          { 
            subscription_status: 'ACTIVE', 
            subscription_ends_at: { $lt: now } 
          },
          { 
            $set: { subscription_status: 'OVERDUE' } 
          }
        );

        const totalUpdated = trialResult.modifiedCount + activeResult.modifiedCount;
        
        if (totalUpdated > 0) {
          console.log(`✅ [CRON] Success: Suspended ${totalUpdated} expired farms.`);
          // (اختياري مستقبلاً: يمكن هنا إرسال أحداث لإرسال إيميلات أو إشعارات للمُلاك)
        } else {
          console.log('✅ [CRON] Success: No expired farms found today.');
        }

      } catch (error) {
        console.error('❌ [CRON] Error updating subscriptions:', error.message);
      }
    }, {
      scheduled: true,
      timezone: "Africa/Cairo" // ضبط التوقيت حسب المنطقة الجغرافية لشريحة العملاء
    });
  }
}

module.exports = new SubscriptionCron();